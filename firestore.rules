rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────

    /// True when the caller is a signed-in user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// True when the caller has the custom "admin" claim.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    /// True when the caller's UID matches the given userId.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── users ─────────────────────────────────────────────────────────
    // Users can read their own profile. Only admins can create/update.
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow write: if isAdmin();
    }

    // ── modules ───────────────────────────────────────────────────────
    // Any authenticated user can read. Only admins can write.
    match /modules/{moduleId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── lessons ───────────────────────────────────────────────────────
    // Any authenticated user can read. Only admins can write.
    match /lessons/{lessonId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();

      // tasks subcollection (legacy — some lessons store tasks here)
      match /tasks/{taskId} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }

      // questions subcollection (used by catalog route)
      match /questions/{questionId} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ── questions (top-level) ─────────────────────────────────────────
    // Any authenticated user can read. Only admins can write.
    match /questions/{questionId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── progress ──────────────────────────────────────────────────────
    // Users can read/write only their own progress documents.
    // Each doc has a "userId" field that must match the caller.
    match /progress/{progressId} {
      allow read:  if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                                         && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── responses ─────────────────────────────────────────────────────
    // Users can create and read their own responses. No updates or deletes.
    match /responses/{responseId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── reports (feedback) ────────────────────────────────────────────
    // Any authenticated user can create a report. Only admins can read.
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Deny everything else by default ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
